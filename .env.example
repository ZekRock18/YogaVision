# YogaVision environment variables
# Copy to .env and fill in values

# Path to trained model (default: models/yoga_cnn.keras)
MODEL_PATH=models/yoga_cnn.keras

# Path to label map JSON (default: models/label_map.json)
LABEL_MAP_PATH=models/label_map.json

# Path to dataset root (default: data/raw/yoga_poses)
DATASET_PATH=data/raw/yoga_poses

# Session history database path
SESSION_DB=outputs/sessions.db

# Enable GPU if available (set to 0 to force CPU)
CUDA_VISIBLE_DEVICES=0

# MediaPipe confidence threshold
MP_MIN_DETECTION_CONFIDENCE=0.5
MP_MIN_TRACKING_CONFIDENCE=0.5
